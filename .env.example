# Required. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Set to 1 to run a canned council with no API key (for UI demos and local development).
# MOCK_COUNCIL=1

# Optional. Override the model used by the five advisors and by Eleven. Default is claude-fable-5-1.
# COUNCIL_MODEL=claude-fable-5-1
# JUDGE_MODEL=claude-fable-5-1

# Optional. When set, decisions and responses are stored in Supabase.
# Run supabase/schema.sql in your project's SQL editor first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
